Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 month"
ExpiresByType font/woff2 "access plus 1 month"
ExpiresByType text/css "access plus 1 day"
ExpiresByType application/javascript "access plus 1 day"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>
<Files "README.md">
Require all denied
</Files>

# BEGIN WEDISON VERIFIED SEO HEADERS
<IfModule mod_mime.c>
AddType text/javascript .js .mjs
AddType font/ttf .ttf
AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
# Apex host only. No includeSubDomains or preload commitment.
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(js|mjs)$">
Header always set Content-Type "text/javascript; charset=utf-8"
</FilesMatch>
<FilesMatch "\.ttf$">
Header always set Content-Type "font/ttf"
</FilesMatch>
<Files "wedison-bali-athena-en.pdf">
Header always set Link "<https://wedison-bali.com/brochures/wedison-bali-athena-en.pdf>; rel=canonical"
</Files>
